{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Backend: DailyPill.Api",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/DailyPill.Api/bin/Debug/net10.0/DailyPill.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/DailyPill.Api",
            "stopAtEntry": false,
            "console": "integratedTerminal"
        },
        {
            "name": "Run Website (vite only)",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev:vite",
            "cwd": "${workspaceFolder}/frontend",

            "serverReadyAction": {
                "pattern": ".*",
                "uriFormat": "http://localhost:5173",
                "action": "openExternally"
            }
        },
        {
            "name": "Run Desktop (vite + electron)",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "cwd": "${workspaceFolder}/frontend"
        }
    ],
    "compounds": [
        {
            "name": "Run DailyPill (backend + desktop)",
            "configurations": ["Backend: DailyPill.Api", "Run Desktop (vite + electron)"]
        }
    ]
}
