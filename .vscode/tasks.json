{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: start (uvicorn)",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "args": ["-m", "uvicorn", "app.main:app", "--port", "8420", "--reload"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Started server process.*$",
          "endsPattern": "^.*Application startup complete.*$"
        }
      },
      "presentation": {
        "panel": "dedicated",
        "group": "dailypill"
      }
    },
    {
      "label": "Frontend: start (vite + electron)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*VITE.*ready.*$",
          "endsPattern": "^.*Local:.*$"
        }
      },
      "presentation": {
        "panel": "dedicated",
        "group": "dailypill"
      }
    },
    {
      "label": "Run DailyPill (backend + frontend)",
      "dependsOn": ["Backend: start (uvicorn)", "Frontend: start (vite + electron)"],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
